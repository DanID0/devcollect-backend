generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id String @id @default(uuid())
  username String @unique
  passwordHashed String
  email String @unique
  avatarUrl String?
  role Role @default(USER)
}


